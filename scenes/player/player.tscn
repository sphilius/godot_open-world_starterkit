hand_socket = NodePath("../Visual/SamuraiModel/Skeleton3D/HandSocket")
sheath_socket = NodePath("../Visual/SamuraiModel/Skeleton3D/SheathSocket")

[node name="Combat" type="Node" parent="." node_paths=PackedStringArray("body", "animation_tree", "katana", "holster", "health", "combo", "warping", "targeting", "guard", "parry", "reaction", "posture")]
script = ExtResource("6_combat")
body = NodePath("..")
animation_tree = NodePath("../AnimationTree")
katana = NodePath("../Katana")
holster = NodePath("../WeaponHolster")
health = NodePath("../HealthComponent")
combo = NodePath("ComboManager")
warping = NodePath("MotionWarping")
targeting = NodePath("../TargetingSystem")
guard = NodePath("../GuardComponent")
parry = NodePath("../ParrySystem")
reaction = NodePath("../DamageReaction")
posture = NodePath("../PostureComponent")
execution = ExtResource("19_execution")

[node name="ComboManager" type="Node" parent="Combat"]
script = ExtResource("7_combo")
graph = ExtResource("8_graph")

[node name="MotionWarping" type="Node" parent="Combat" node_paths=PackedStringArray("body", "targeting")]
script = ExtResource("9_warping")
body = NodePath("../..")
targeting = NodePath("../../TargetingSystem")

[node name="TargetingSystem" type="Node" parent="." node_paths=PackedStringArray("body", "camera")]
script = ExtResource("14_targeting")
body = NodePath("..")
camera = NodePath("../CameraRig")

[node name="CameraRig" type="Node3D" parent="." node_paths=PackedStringArray("targeting")]
top_level = true
script = ExtResource("13_camera")
targeting = NodePath("../TargetingSystem")

[node name="SpringArm3D" type="SpringArm3D" parent="CameraRig"]
shape = SubResource("SphereShape3D_camera")
spring_length = 4.2
margin = 0.15

[node name="Camera3D" type="Camera3D" parent="CameraRig/SpringArm3D"]
current = true
fov = 68.0
far = 1500.0

[ext_resource type="Script" path="res://scripts/combat/weapon_holster.gd" id="5_holster"]
[ext_resource type="Script" path="res://scripts/combat/combat_state_machine.gd" id="6_combat"]
[ext_resource type="Script" path="res://scripts/combat/combo_manager.gd" id="7_combo"]
[ext_resource type="Resource" path="res://resources/combat/sword_combo.tres" id="8_graph"]
[ext_resource type="Script" path="res://scripts/combat/motion_warping.gd" id="9_warping"]
[ext_resource type="Script" path="res://scripts/camera/combat_camera.gd" id="13_camera"]
[ext_resource type="Script" path="res://scripts/combat/targeting_system.gd" id="14_targeting"]
[ext_resource type="Script" path="res://scripts/combat/health_component.gd" id="11_health"]
[ext_resource type="Script" path="res://scripts/combat/hurtbox.gd" id="12_hurtbox"]
[ext_resource type="Script" path="res://scripts/combat/defense/posture_component.gd" id="15_posture"]
[ext_resource type="Script" path="res://scripts/combat/defense/guard_component.gd" id="16_guard"]
[ext_resource type="Script" path="res://scripts/combat/defense/parry_system.gd" id="17_parry"]
[ext_resource type="Script" path="res://scripts/combat/defense/damage_reaction_component.gd" id="18_reaction"]
[ext_resource type="Resource" path="res://resources/combat/execution.tres" id="19_execution"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]
radius = 0.35
height = 1.8

[sub_resource type="SphereShape3D" id="SphereShape3D_camera"]
radius = 0.2

[node name="Player" type="CharacterBody3D" groups=["player"] node_paths=PackedStringArray("targeting")]
collision_layer = 2
collision_mask = 5
script = ExtResource("1_controller")
targeting = NodePath("TargetingSystem")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
position = Vector3(0, 0.9, 0)
shape = SubResource("CapsuleShape3D_body")

[node name="HealthComponent" type="Node" parent="."]
script = ExtResource("11_health")
max_health = 100.0
invulnerability_time = 0.8

[node name="Hurtbox" type="Area3D" parent="." node_paths=PackedStringArray("health", "posture")]
collision_layer = 64
collision_mask = 0
monitoring = false
script = ExtResource("12_hurtbox")
health = NodePath("../HealthComponent")
posture = NodePath("../PostureComponent")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Hurtbox"]
position = Vector3(0, 0.9, 0)
shape = SubResource("CapsuleShape3D_body")

[node name="PostureComponent" type="Node" parent="." node_paths=PackedStringArray("health", "guard", "body")]
script = ExtResource("15_posture")
health = NodePath("../HealthComponent")
guard = NodePath("../GuardComponent")
body = NodePath("..")

[node name="GuardComponent" type="Node" parent="." node_paths=PackedStringArray("hurtbox", "posture", "body")]
script = ExtResource("16_guard")
hurtbox = NodePath("../Hurtbox")
posture = NodePath("../PostureComponent")
body = NodePath("..")

[node name="ParrySystem" type="Node" parent="." node_paths=PackedStringArray("hurtbox", "guard")]
script = ExtResource("17_parry")
hurtbox = NodePath("../Hurtbox")
guard = NodePath("../GuardComponent")

[node name="DamageReaction" type="Node" parent="." node_paths=PackedStringArray("body", "hurtbox", "posture", "guard")]
script = ExtResource("18_reaction")
body = NodePath("..")
hurtbox = NodePath("../Hurtbox")
posture = NodePath("../PostureComponent")
guard = NodePath("../GuardComponent")

[node name="Visual" type="Node3D" parent="."]

[node name="SamuraiModel" parent="Visual" instance=ExtResource("2_model")]

[node name="Katana" parent="." instance=ExtResource("3_katana")]

[node name="AnimationTree" type="AnimationTree" parent="."]
root_node = NodePath("../Visual/SamuraiModel")
callback_mode_process = 0
tree_root = ExtResource("4_state_machine")
anim_player = NodePath("../Visual/SamuraiModel/AnimationPlayer")

[node name="WeaponHolster" type="Node" parent="." node_paths=PackedStringArray("katana", "hand_socket", "sheath_socket")]
script = ExtResource("5_holster")
